# ── Gmail settings ──────────────────────────────────────────────────────────
# Your Gmail address
GMAIL_USER=your@gmail.com

# Google App Password (16 chars, spaces optional)
# How to get one:
#   1. myaccount.google.com → Security → 2-Step Verification (enable it)
#   2. Search "App passwords" → Create → Mail → Copy the 16-char password
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where contact form emails go (usually same as GMAIL_USER, or a different inbox)
RECIPIENT_EMAIL=rajvibhatt21@gmail.com

# Frontend URL for CORS — change to your deployed URL in production
FRONTEND_URL=http://localhost:5173

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
